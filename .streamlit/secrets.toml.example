# For Streamlit Community Cloud: paste these (with real values) into
# App settings -> Secrets. Never commit a real secrets.toml.
FALKORDB_HOST = "your-instance.falkordb.cloud"
FALKORDB_PORT = "6379"
FALKORDB_USERNAME = "falkordb"
FALKORDB_PASSWORD = "your-password"
FALKORDB_SSL = "false"

# Claude:
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."
# or Gemini (free tier): LLM_PROVIDER = "gemini" and GEMINI_API_KEY = "..."
AGENT_MODE = "team"
DEMO_MODE = "auto"
MAX_LIVE_QUESTIONS = "25"
