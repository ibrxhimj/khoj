# Copy this file to .env and fill in your values. Never commit .env.

# --- FalkorDB (FalkorDB Cloud or local Docker) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Set to true only if your FalkorDB Cloud instance has TLS enabled
FALKORDB_SSL=false

# Graph names (defaults are fine)
KG_GRAPH=khoj_bangalore
BUYER_GRAPH_PREFIX=khoj_buyer_

# --- LLM ---
# anthropic (Claude) or gemini (free tier from Google AI Studio)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For Gemini instead: LLM_PROVIDER=gemini and set GEMINI_API_KEY (models default to gemini-3.8-flash)
GEMINI_API_KEY=
# Optional model overrides
# CONCIERGE_MODEL=
# INVESTIGATOR_MODEL=

# Risk model (defaults are fine)
RISK_MAX_HOPS=4
RISK_BETA=0.6

# Demo mode: live | replay | auto (live when an API key is set, else recorded runs)
DEMO_MODE=auto
MAX_LIVE_QUESTIONS=25
